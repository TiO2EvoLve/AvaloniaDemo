<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:AvaloniaTestDemo.Views"
             x:DataType="vm:PhotoDropViewModel"
             x:Class="AvaloniaTestDemo.Views.PhotoDropView">
    <Border
        Margin="20" BorderBrush="Lavender" BorderThickness="1" CornerRadius="20"
        DragDrop.AllowDrop="True" BoxShadow="0 4 12 0 #40000000"
        DragDrop.DragOver="DropZone_DragOver"
        DragDrop.Drop="DropZone_Drop" Background="Transparent">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image
                Source="{Binding PreviewImage}"
                MaxWidth="500"
                MaxHeight="500"
                IsVisible="{Binding HasImage}" />

            <TextBlock
                Text="请拖动图片" FontFamily="Segoe UI,Microsoft YaHei"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"
                IsVisible="{Binding !HasImage}" />
        </StackPanel>
        
    </Border>


</UserControl>