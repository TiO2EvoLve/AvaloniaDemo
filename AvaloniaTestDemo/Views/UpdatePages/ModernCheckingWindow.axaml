<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaTestDemo.Views.UpdatePages.ModernCheckingWindow"
        Title="检查更新"
        Width="460" Height="300"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        RequestedThemeVariant="Light"
        Background="#F4F6F8">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,11" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Height" Value="8" />
        </Style>
    </Window.Styles>

    <Border Margin="20" Background="White" CornerRadius="18"
            BorderBrush="#E6E9EE" BorderThickness="1" Padding="28">
        <Grid RowDefinitions="Auto,*,Auto">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <StackPanel VerticalAlignment="Center" Spacing="5">
                    <TextBlock Text="正在检查更新" FontSize="22" FontWeight="Bold" Foreground="#1A2332" />
                    <TextBlock Text="正在连接更新服务器，请稍候…" FontSize="13" Foreground="#5C6B7A" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10">
                <ProgressBar IsIndeterminate="True" Background="#E8ECF0" Foreground="#0F766E" />
                <TextBlock Text="这通常只需要几秒钟" Foreground="#8A97A6" FontSize="12" />
            </StackPanel>

            <Button Grid.Row="2" Content="取消" HorizontalAlignment="Right"
                    Background="#F3F4F6" Foreground="#374151"
                    Click="Cancel_Click" />
        </Grid>
    </Border>
</Window>
