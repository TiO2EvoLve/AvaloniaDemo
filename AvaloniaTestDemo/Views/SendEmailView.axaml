<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:AvaloniaTestDemo.Views"
             x:DataType="vm:SendEmailViewModel"
             x:Class="AvaloniaTestDemo.Views.SendEmailView">
    <Design.DataContext>
        <vm:SendEmailViewModel />
    </Design.DataContext>

    <Grid Margin="20" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
        <StackPanel Orientation="Vertical">
            <Label Content="发件人邮箱:" />
            <TextBox Text="{Binding fromEmail}"
                     TextWrapping="Wrap" Width="200" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Vertical">
            <Label Content="发件人密码:" />
            <TextBox Text="{Binding password}"
                     Width="200" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Vertical">
            <Label Content="收件人邮箱:" />
            <TextBox Text="{Binding toEmail}"
                     TextWrapping="Wrap" Width="200" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Vertical">
            <Label Content="邮件主题:" />
            <TextBox Text="{Binding subject}"
                     TextWrapping="Wrap" Width="200" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Vertical">
            <Label Content="邮件正文:" />
            <TextBox Text="{Binding body}"
                     TextWrapping="Wrap" Width="400" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Grid.Row="5" HorizontalAlignment="Left">
            <Button Classes="Flat"  Content="发送邮件" Command="{Binding SendEmail_ClickCommand}" />
        </StackPanel>
    </Grid>
</UserControl>