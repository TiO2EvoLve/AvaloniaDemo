<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:AvaloniaTestDemo.Views"
             x:DataType="vm:HarmonyModViewModel"
             x:Class="AvaloniaTestDemo.Views.HarmonyModView"
             x:Name="root">

    <Design.DataContext>
        <vm:HarmonyModViewModel />
    </Design.DataContext>

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="演示 Harmony 如何对方法进行运行时修改（mod）"/>
        <TextBlock Text="输入名字，调用原始方法或应用补丁后再次调用以查看区别。"/>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock VerticalAlignment="Center" Text="Name:"/>
            <TextBox Width="200" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="显示结果" Command="{Binding ShowOriginalCommand}"/>
            <Button Content="应用 Harmony 补丁" Command="{Binding ApplyPatchCommand}"/>
        </StackPanel>

        <Border BorderThickness="1" Padding="10" Margin="5">
            <StackPanel>
                <TextBlock Text="结果:" FontWeight="Bold" />
                <TextBlock Text="{Binding Result}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding IsPatched, StringFormat='已打补丁: {0}'}" />
            </StackPanel>
        </Border>
    </StackPanel>

</UserControl>

