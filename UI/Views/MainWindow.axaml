<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UI.ViewModels"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1500" d:DesignHeight="1000"
        Width="1200" Height="800"
        x:Class="UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="Default"
        TransparencyLevelHint="Mica"
        Background="Transparent"
        Title="UI">

    <Window.Styles>
        <Style Selector="Button.titlebar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.titlebar:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E8E8E8"/>
        </Style>
        <Style Selector="Button.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E81123"/>
        </Style>
        <Style Selector="Button.close:pointerover Path">
            <Setter Property="Stroke" Value="White"/>
        </Style>

        <Style Selector="Button.sidebarItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#3D3D3A"/>
        </Style>
        <Style Selector="Button.sidebarItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#ECE8E3"/>
        </Style>

        <Style Selector="Button.pill">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E3DFD8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#5C5A56"/>
        </Style>
        <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F4F1EC"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="40,*">
        
        <!-- Custom title bar -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="#FBF3EE" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="4">
                <!-- back / forward -->
                <Path Data="M12,4 L6,10 L12,16" Stroke="#8A8784" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                      Width="14" Height="14" Stretch="Uniform" Margin="6,0,0,0"/>
                <Path Data="M6,4 L12,10 L6,16" Stroke="#C9C5BF" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                      Width="14" Height="14" Stretch="Uniform" Margin="6,0,0,0"/>

                <!-- File Edit View Help menu -->
                <Menu>
                    <MenuItem Header="File"/>
                    <MenuItem Header="Edit"/>
                    <MenuItem Header="View"/>
                    <MenuItem Header="Help"/>
                </Menu>
            </StackPanel>
            
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" ColumnDefinitions="280,*" >

            <!-- Sidebar -->
            <Border Margin="10" Background="White" BorderBrush="#E3DFD8" BorderThickness="1" CornerRadius="10">
            <Grid Grid.Column="0"  RowDefinitions="*,Auto">
                
                <StackPanel Grid.Row="0" Margin="16,16,16,0" Spacing="2">

                    <!-- New chat -->
                    <Button Classes="sidebarItem" FontWeight="Medium">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <i:Icon Value="fa-pen-to-square" />
                            <TextBlock Text="New chat" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Search -->
                    <Button Classes="sidebarItem">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <i:Icon Value="fa-sistrix" />
                            <TextBlock Text="Search" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Plugins -->
                    <Button Classes="sidebarItem">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <i:Icon Value="fa-plug" />
                            <TextBlock Text="Plugins" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Projects label -->
                    <TextBlock Text="Projects" Foreground="#A8A39C" FontSize="12" Margin="12,18,0,4"/>

                    <Button Classes="sidebarItem">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                                <i:Icon Value="fa-folder" />
                            <TextBlock Text="AvaloniaTestDemo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Chats label -->
                    <TextBlock Text="Chats" Foreground="#A8A39C" FontSize="12" Margin="12,18,0,4"/>
                    <TextBlock Text="No chats" Foreground="#C5C1BB" FontSize="13" Margin="12,2,0,0"/>

                </StackPanel>

                <!-- bottom settings -->
                <Grid Grid.Row="1" Margin="16,0,16,16" ColumnDefinitions="*,Auto">
                    <Button Grid.Column="0" Classes="sidebarItem">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <i:Icon Value="fa-gear" />
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Content="Upgrade" Background="#FFFFFF" BorderBrush="#E3DFD8"
                            BorderThickness="1" CornerRadius="8" Padding="14,6" FontSize="13"
                            Foreground="#3D3D3A" VerticalAlignment="Center"/>
                </Grid>
                
            </Grid>
            </Border>

            <!-- Main content -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">

                <!-- top bar -->
                <Grid Grid.Row="0" Margin="32,16,32,0" ColumnDefinitions="*,Auto">
                    <Button Grid.Column="0" HorizontalAlignment="Left"
                            Background="#F3E8FF" BorderThickness="0" CornerRadius="20" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M7,0 L9,5 L14,7 L9,9 L7,14 L5,9 L0,7 L5,5 Z" Fill="#9333EA"
                                  Width="14" Height="14" Stretch="Uniform"/>
                            <TextBlock Text="Get Plus" Foreground="#9333EA" FontWeight="Medium" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <!-- avatar -->
                        <Border CornerRadius="6" Background="#1F1B16" Padding="8,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="VS Code" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <i:Icon Value="fa-angle-down" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <Border Width="36" Height="36" CornerRadius="8" Background="#FFFFFF" BorderBrush="#E3DFD8" BorderThickness="1">
                            <i:Icon Value="fa-bars"/>
                        </Border>
                        <Border Width="36" Height="36" CornerRadius="8" Background="#FFFFFF" BorderBrush="#E3DFD8" BorderThickness="1">
                            <i:Icon Value="fa-table-columns"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Center content -->
                <Grid Grid.Row="1" Margin="32">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Spacing="32" MinWidth="800" MaxWidth="1000">

                        <TextBlock Text="What should we build?" FontSize="40" FontWeight="Medium"
                                    Foreground="#1F1B16" HorizontalAlignment="Center"/>

                        <!-- Input box -->
                        <Border Background="#FFFFFF" BorderBrush="#E3DFD8" BorderThickness="1" CornerRadius="20" Padding="24,20,24,16">
                            <StackPanel Spacing="16">

                                <TextBlock Text="Do anything" Foreground="#C5C1BB" FontSize="16"/>

                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <!-- plus button -->
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                            BorderBrush="#E3DFD8" BorderThickness="1" Background="Transparent">
                                        <Path Data="M8,2 L8,14 M2,8 L14,8" Stroke="#8A8784" StrokeThickness="1.6"
                                              StrokeLineCap="Round" Width="14" Height="14" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Full access pill -->
                                    <Button Grid.Column="1" HorizontalAlignment="Left" Margin="12,0,0,0"
                                            Background="Transparent" BorderBrush="#F0D9B5" BorderThickness="1"
                                            CornerRadius="16" Padding="12,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6" >
                                            <i:Icon Value="fa-exclamation" Foreground="#D97706"/>
                                            <TextBlock Text="Full access" Foreground="#D97706" FontSize="13" VerticalAlignment="Center"/>
                                            <Path Data="M0,0 L4,4 L8,0" Stroke="#D97706" StrokeThickness="1.4"
                                                  Width="8" Height="5" Stretch="Uniform" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- model selector -->
                                    <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="6,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="5.5" Foreground="#1F1B16" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="Medium" Foreground="#5C5A56" FontSize="13" VerticalAlignment="Center"/>
                                            <Path Data="M0,0 L4,4 L8,0" Stroke="#8A8784" StrokeThickness="1.4"
                                                  Width="8" Height="5" Stretch="Uniform" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- send button -->
                                    <Border Grid.Column="3" Width="36" Height="36" CornerRadius="18" Background="#D9D5CF" Margin="12,0,0,0">
                                        <i:Icon Value="fa-arrow-up" Foreground="#D97706"/>
                                    </Border>
                                </Grid>

                                <!-- bottom selectors row -->
                                <Border BorderBrush="#EFEBE5" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Classes="pill">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                
                                                <TextBlock Text="AvaloniaTestDemo" VerticalAlignment="Center"/>
                                                <Path Data="M0,0 L4,4 L8,0" Stroke="#8A8784" StrokeThickness="1.4"
                                                      Width="8" Height="5" Stretch="Uniform" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="pill">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Work locally" VerticalAlignment="Center"/>
                                                <Path Data="M0,0 L4,4 L8,0" Stroke="#8A8784" StrokeThickness="1.4"
                                                      Width="8" Height="5" Stretch="Uniform" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="pill">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="6" Height="6" Fill="#8A8784" VerticalAlignment="Center"/>
                                                <TextBlock Text="master" VerticalAlignment="Center"/>
                                                <Path Data="M0,0 L4,4 L8,0" Stroke="#8A8784" StrokeThickness="1.4"
                                                      Width="8" Height="5" Stretch="Uniform" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Grid>

</Window>
