<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:AvaloniaTestDemo.Views"
             x:DataType="vm:QRCodeViewModel"
             x:Class="AvaloniaTestDemo.Views.QRCodeView">
    <Design.DataContext>
        <vm:QRCodeViewModel/>
    </Design.DataContext>
    <Grid RowDefinitions="Auto,*">

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,0">
            <TextBox Text="{Binding Text}" Width="200" />
            <Button Command="{Binding SpawnQRCodeCommand}" Height="40" Margin="10,0,0,0"
                    >
                生成二维码
            </Button>
            <Button x:Name="savebutton" Command="{Binding SaveCommand}" Height="40"
                     Margin="10,0,0,0">
                保存二维码
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border BorderBrush="Black" BorderThickness="1" CornerRadius="5" Padding="10">
                <Image Source="{Binding Image}"  Width="200" Height="200" />
            </Border>

        </StackPanel>

    </Grid>
</UserControl>
