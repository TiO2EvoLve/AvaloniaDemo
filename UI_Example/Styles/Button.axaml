<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- 设计时预览（可选） -->
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Spacing="10">
                <Button Classes="Success">Success Button</Button>
                <Button Classes="Danger">Danger Button</Button>
            </StackPanel>
        </Border>
    </Design.PreviewWith>
    
    <!-- 定义样式 -->
    <Style Selector="Button.Success">
        <Setter Property="Background" Value="#f6ffed" />
        <Setter Property="Foreground" Value="#52c41a" />
        <Setter Property="BorderBrush" Value="#b7eb8f" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    
    <Style Selector="Button.Success:pointerover">
        <Setter Property="Background" Value="#52c41a" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    
    <Style Selector="Button.Danger">
        <Setter Property="Background" Value="#fff1f0" />
        <Setter Property="Foreground" Value="#ff4d4f" />
        <Setter Property="BorderBrush" Value="#ffa39e" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    
    <Style Selector="Button.Danger:pointerover">
        <Setter Property="Background" Value="#ff4d4f" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    
</Styles>
