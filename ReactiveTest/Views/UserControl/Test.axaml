<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:ReactiveTest.ViewModels"
             x:DataType="vm:TestViewModel"
             x:Class="ReactiveTest.Views.UserControl.Test">
    <Design.DataContext>
        <vm:TestViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" Margin="10">
        <StackPanel Spacing="10" Orientation="Horizontal">
            <TextBox Text="{Binding Name}" PlaceholderText="输入不为空才能点击按钮"/>
            <Button Command="{Binding SaveCommand}">BUTTON</Button>
        </StackPanel>
    </Grid>

</UserControl>
