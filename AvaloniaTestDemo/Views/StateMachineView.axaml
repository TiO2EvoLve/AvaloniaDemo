<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:AvaloniaTestDemo.Views"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             x:DataType="vm:StateMachineViewModel"
             x:Class="AvaloniaTestDemo.Views.StateMachineView">
    <Design.DataContext>
        <vm:StateMachineViewModel />
    </Design.DataContext>
    
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <TextBlock Text="{Binding CurrentStateText}" FontSize="16"/>
            <StackPanel HorizontalAlignment="Center" Spacing="10" Orientation="Horizontal">
                <Button Classes="Flat" Background="LimeGreen" Content="支付" Command="{Binding PayCommand}"/>
                <Button Classes="Flat" Background="Coral" Content="发货"  Command="{Binding ShipCommand}"/>
                <Button Classes="Flat" Background="DodgerBlue" Content="完成" Command="{Binding CompleteCommand}"/>
                <Button Classes="Flat" Background="DimGray" Content="取消" Command="{Binding CancelCommand}"/>
                <Button Classes="Flat" Background="MediumPurple" Content="重置" Command="{Binding ResetCommand}"/>
            </StackPanel>
        </StackPanel>
           
    </Grid>
</UserControl>
