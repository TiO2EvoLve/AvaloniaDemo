<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:AvaloniaTestDemo.Views"
             x:DataType="vm:BindingViewModel"
             x:Class="AvaloniaTestDemo.Views.BindingView">
    <Design.DataContext>
        <vm:BindingViewModel/>
    </Design.DataContext>
    <Grid RowDefinitions="Auto,Auto,Auto">
        <StackPanel Margin="20" Spacing="10" >
            <ComboBox>
                <ComboBoxItem Content="选项1" x:Name="BoxItem1"/>
                <ComboBoxItem Content="选项2" x:Name="BoxItem2" IsSelected="True"/>
                <ComboBoxItem Content="选项3" x:Name="BoxItem3"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" IsVisible="{Binding #BoxItem1.IsSelected, ElementName=BoxItem1}">
            <Button >BUTTON</Button>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="20" Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding #BoxItem2.IsSelected, ElementName=BoxItem1}">
           <Grid ColumnDefinitions="Auto,*" >
               <TextBlock Text="用户名:" VerticalAlignment="Center" Margin="0,0,5,0"/>
               <TextBox Grid.Column="1" Width="200" />
           </Grid>
        </StackPanel>
    </Grid>
</UserControl>