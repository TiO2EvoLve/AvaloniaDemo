<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaTestDemo.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:LiteDBViewModel"
             x:Class="AvaloniaTestDemo.Views.LiteDBView">
    <Design.DataContext>
        <vm:LiteDBViewModel />
    </Design.DataContext>
    
     <Grid RowDefinitions="Auto,Auto,*,Auto"
          Margin="20">

        <!-- 标题 -->
        <TextBlock
            Grid.Row="0"
            Text="LiteDB 增删改查 Demo"
            FontSize="26"
            FontWeight="Bold"
            Margin="0,0,0,20"/>

        <!-- 输入区域 -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="Auto,200,Auto,100,*"
            RowDefinitions="Auto,Auto"
            Margin="0,0,0,15">

            <TextBlock
                Grid.Column="0"
                Text="姓名："
                VerticalAlignment="Center"/>

            <TextBox
                Grid.Column="1"
                Text="{Binding Name}"
                Margin="5"/>

            <TextBlock
                Grid.Column="2"
                Text="年龄："
                VerticalAlignment="Center"
                Margin="15,0,0,0"/>

            <NumericUpDown
                Grid.Column="3"
                Value="{Binding Age}"
                Minimum="0"
                Maximum="150"
                Margin="5"/>

        </Grid>

        <!-- 数据表格 -->
        <DataGrid
            Grid.Row="2"
            ItemsSource="{Binding Users}"
            SelectedItem="{Binding SelectedUser}"
            AutoGenerateColumns="False"
            GridLinesVisibility="All"
            IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="ID"
                    FontSize="18"
                    Binding="{Binding Id}"
                    Width="100"/>

                <DataGridTextColumn
                    Header="姓名"
                    FontSize="18"
                    Binding="{Binding Name}"
                    Width="100"/>

                <DataGridTextColumn
                    Header="年龄"
                    FontSize="18"
                    Binding="{Binding Age}"
                    Width="100"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- 操作区域 -->
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Margin="0,15,0,0">

            <Button
                Content="新增"
                Command="{Binding AddUserCommand}"
                Width="100"
                Margin="0,0,10,0"/>

            <Button
                Content="修改"
                Command="{Binding UpdateUserCommand}"
                Width="100"
                Margin="0,0,10,0"/>

            <Button
                Content="删除"
                Command="{Binding DeleteUserCommand}"
                Width="100"
                Margin="0,0,10,0"/>

            <Button
                Content="刷新"
                Command="{Binding RefreshCommand}"
                Width="100"
                Margin="0,0,10,0"/>

            <Button
                Content="清空"
                Command="{Binding ClearInputCommand}"
                Width="100"/>

            <TextBlock
                Text="{Binding Message}"
                VerticalAlignment="Center"
                Margin="20,0,0,0"/>

        </StackPanel>

    </Grid>
</UserControl>
