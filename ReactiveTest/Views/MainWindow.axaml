<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ReactiveTest.ViewModels"
    x:Class="ReactiveTest.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    Title="ReactiveTest">

    <Grid RowDefinitions="Auto, *" RowSpacing="10">
        <StackPanel Orientation="Horizontal" Margin="10" Spacing="10">
            <Button Command="{Binding NavigateCommand}" CommandParameter="readcard">Read Card</Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="test">TEST</Button>
        </StackPanel>

        <!-- Sextant 导航视图在 App.OnFrameworkInitializationCompleted 中填充 -->
        <ContentControl Grid.Row="1" x:Name="NavigationHost" />
    </Grid>

</Window>
