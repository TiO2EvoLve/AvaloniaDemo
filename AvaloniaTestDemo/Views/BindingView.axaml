<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:AvaloniaTestDemo.Views"
             x:DataType="vm:BindingViewModel"
             x:Class="AvaloniaTestDemo.Views.BindingView">
    <Design.DataContext>
        <vm:BindingViewModel/>
    </Design.DataContext>
    <Grid>
        <StackPanel Margin="20" Spacing="10" >
            <ComboBox>
                <ComboBoxItem Content="选项1"/>
                <ComboBoxItem Content="选项2"/>
                <ComboBoxItem Content="选项3"/>
            </ComboBox>
            <WrapPanel ItemSpacing="10" >
                <TextBlock  VerticalAlignment="Center" Text="输入文本:"/>
                <TextBox x:Name="text1" Width="200"/>
            </WrapPanel>
            <TextBlock Text="{Binding #text1.Text}" FontSize="16"/>
        </StackPanel>
        <StackPanel Margin="20">
           
        </StackPanel>
    </Grid>
</UserControl>